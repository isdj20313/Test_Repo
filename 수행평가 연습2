#include <stdio.h>//시작을 위해 헤더파일 가져오기

int main() {
    
    
    int i;// 반복문에서 숫자를 1씩 증가시킬 변수 i 설정
    int sum = 0; // 합계를 저장할 변수를 0으로 비워둠
    for (i = 1; i <= 10; i++) {// i가 1부터 시작해서 10보다 작을 동안(1~10) 반복
        sum = sum + i;// 기존 sum에 현재의 i를 더해서 다시 sum에 저장
    }

    printf("1부터 10까지의 합: %d\n", sum);// 1부터 10까지 더한 최종 결과 출력
    if (sum % 2 == 0) { // sum을 2로 나눈 나머지가 0이면 (짝수 판별)
        printf("결과는 짝수입니다.\n");//짝수일때 결과출력
    } else {
        printf("결과는 홀수입니다.\n");//홀수일때 결과출력
    }

    return 0;
}
